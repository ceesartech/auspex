# ============= DATABASE =============
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_USER=betting_user
POSTGRES_PASSWORD=change_me_in_production_MUST_BE_STRONG
POSTGRES_DB=betting_system
DATABASE_URL=postgresql://betting_user:change_me_in_production_MUST_BE_STRONG@localhost:5433/betting_system

# ============= REDIS =============
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_URL=redis://localhost:6379/0
REDIS_CACHE_DB=0
REDIS_CELERY_DB=1
REDIS_RESULTS_DB=2

# ============= AIRFLOW =============
AIRFLOW_HOME=/opt/airflow
AIRFLOW__CORE__EXECUTOR=LocalExecutor
AIRFLOW__DATABASE__SQL_ALCHEMY_CONN=postgresql://betting_user:change_me_in_production_MUST_BE_STRONG@localhost:5433/betting_system
AIRFLOW__CORE__FERNET_KEY=GENERATE_WITH_COMMAND_python_-c_"from_cryptography.fernet_import_Fernet;_print(Fernet.generate_key().decode())"
AIRFLOW__WEBSERVER__SECRET_KEY=GENERATE_RANDOM_SECRET_KEY_32_CHARS
AIRFLOW__CORE__LOAD_EXAMPLES=False

# ============= GCP =============
GCP_PROJECT_ID=your-project-id
GCP_REGION=us-central1
GCP_ZONE=us-central1-a
GCS_BUCKET=your-bucket-name
GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account-key.json

# ============= SUPABASE =============
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_anon_key
SUPABASE_SERVICE_KEY=your_service_key

# ============= MONGODB =============
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/betting_system
MONGODB_DB=betting_system

# ============= JWT & SECURITY =============
JWT_SECRET=GENERATE_RANDOM_JWT_SECRET_AT_LEAST_32_CHARS
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24
SECRET_KEY=GENERATE_RANDOM_SECRET_KEY_64_CHARS

# ============= USER =============
USER_DOB=1994-05-09
USER_LOCATION="Colorado, USA"
USER_TIMEZONE=America/Denver

# ============= API =============
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=4
API_RELOAD=false
CORS_ORIGINS=["http://localhost:3000","https://yourdomain.com"]

# ============= FRONTEND =============
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000

# ============= MLFLOW =============
MLFLOW_TRACKING_URI=http://localhost:5001
# Local dev uses SQLite (no separate DB needed).
# Production: postgresql://betting_user:PASSWORD@DB_HOST:5432/mlflow
MLFLOW_BACKEND_STORE_URI=sqlite:///mlflow/mlflow.db
MLFLOW_ARTIFACT_ROOT=gs://your-bucket-name/mlflow-artifacts

# ============= MONITORING =============
GRAFANA_PASSWORD=admin_change_me
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000

# ============= TELEGRAM ALERTS (OPTIONAL) =============
TELEGRAM_BOT_TOKEN=your_bot_token
TELEGRAM_CHAT_ID=your_chat_id

# ============= LIVE ODDS (OPTIONAL BUT RECOMMENDED) =============
# the-odds-api.com — 500 free requests/month, no credit card required.
# Sign up at https://the-odds-api.com, click "Get API Key", verify email.
# Without this, predictions for upcoming matches fall back to the
# home-advantage prior (~43% home / 28% draw / 28% away) because
# there are no live odds to derive implied probabilities from.
THE_ODDS_API_KEY=

# ============= PROXIES (OPTIONAL) =============
USE_PROXIES=false
PROXY_LIST_URL=
ROTATING_PROXY_URL=

# ============= FEATURE FLAGS =============
ENABLE_WEB_SCRAPING=true
ENABLE_MODEL_TRAINING=true
ENABLE_PREDICTIONS=true
ENABLE_TELEGRAM_NOTIFICATIONS=false

# ============= LOGGING =============
LOG_LEVEL=INFO
LOG_FORMAT=json
LOG_FILE=/var/log/betting-system/app.log
