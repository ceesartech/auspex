{
  "dashboard": {
    "id": null,
    "uid": "scraping-status",
    "title": "Scraping Status",
    "tags": ["scraping", "data-ingestion"],
    "timezone": "browser",
    "schemaVersion": 36,
    "version": 1,
    "refresh": "1m",
    "time": { "from": "now-6h", "to": "now" },
    "panels": [
      {
        "id": 1,
        "title": "Records Scraped per Hour",
        "type": "timeseries",
        "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
        "targets": [
          {
            "expr": "sum(rate(scraping_records_total[1h]) * 3600) by (scraper)",
            "legendFormat": "{{ scraper }}"
          }
        ],
        "fieldConfig": { "defaults": { "unit": "short" } }
      },
      {
        "id": 2,
        "title": "Scraping Error Rate",
        "type": "timeseries",
        "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
        "targets": [
          {
            "expr": "sum(rate(scraping_errors_total[15m])) by (scraper, error_type)",
            "legendFormat": "{{ scraper }} / {{ error_type }}"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "short",
            "thresholds": {
              "steps": [
                { "color": "green", "value": 0 },
                { "color": "yellow", "value": 0.05 },
                { "color": "red", "value": 0.1 }
              ]
            }
          }
        }
      },
      {
        "id": 3,
        "title": "Odds Data Freshness",
        "type": "stat",
        "gridPos": { "h": 4, "w": 6, "x": 0, "y": 8 },
        "targets": [
          {
            "expr": "time() - odds_last_updated_timestamp",
            "legendFormat": "Seconds Since Last Update"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "s",
            "thresholds": {
              "steps": [
                { "color": "green", "value": 0 },
                { "color": "yellow", "value": 180 },
                { "color": "red", "value": 300 }
              ]
            }
          }
        }
      },
      {
        "id": 4,
        "title": "Scraper Success Rate (24h)",
        "type": "bargauge",
        "gridPos": { "h": 8, "w": 12, "x": 6, "y": 8 },
        "targets": [
          {
            "expr": "sum(increase(scraping_records_total[24h])) by (scraper) / (sum(increase(scraping_records_total[24h])) by (scraper) + sum(increase(scraping_errors_total[24h])) by (scraper))",
            "legendFormat": "{{ scraper }}"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "percentunit",
            "min": 0,
            "max": 1
          }
        }
      },
      {
        "id": 5,
        "title": "Airflow DAG Status",
        "type": "table",
        "gridPos": { "h": 8, "w": 24, "x": 0, "y": 16 },
        "targets": [
          {
            "expr": "airflow_dag_run_duration_success",
            "legendFormat": "{{ dag_id }}"
          }
        ]
      }
    ]
  }
}
