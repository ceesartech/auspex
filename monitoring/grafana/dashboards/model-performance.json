{
  "dashboard": {
    "id": null,
    "uid": "model-performance",
    "title": "ML Model Performance",
    "tags": ["ml", "models", "performance"],
    "timezone": "browser",
    "schemaVersion": 36,
    "version": 1,
    "refresh": "5m",
    "time": { "from": "now-7d", "to": "now" },
    "panels": [
      {
        "id": 1,
        "title": "Model Accuracy (7-day rolling)",
        "type": "timeseries",
        "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
        "targets": [
          {
            "expr": "model_accuracy_7d",
            "legendFormat": "7d Accuracy"
          },
          {
            "expr": "model_accuracy_30d",
            "legendFormat": "30d Accuracy"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "percentunit",
            "min": 0,
            "max": 1,
            "thresholds": {
              "steps": [
                { "color": "red", "value": 0 },
                { "color": "yellow", "value": 0.55 },
                { "color": "green", "value": 0.65 }
              ]
            }
          }
        }
      },
      {
        "id": 2,
        "title": "ROI Trend",
        "type": "timeseries",
        "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
        "targets": [
          {
            "expr": "model_roi_7d",
            "legendFormat": "7-day ROI"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "percentunit",
            "thresholds": {
              "steps": [
                { "color": "red", "value": -0.1 },
                { "color": "yellow", "value": 0 },
                { "color": "green", "value": 0.05 }
              ]
            }
          }
        }
      },
      {
        "id": 3,
        "title": "Prediction Volume",
        "type": "timeseries",
        "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
        "targets": [
          {
            "expr": "sum(rate(predictions_total[1h])) by (predicted_outcome)",
            "legendFormat": "{{ predicted_outcome }}"
          }
        ],
        "fieldConfig": {
          "defaults": { "unit": "reqps" }
        }
      },
      {
        "id": 4,
        "title": "Prediction Confidence Distribution",
        "type": "histogram",
        "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
        "targets": [
          {
            "expr": "sum(rate(prediction_confidence_bucket[1h])) by (le)",
            "format": "heatmap",
            "legendFormat": "{{ le }}"
          }
        ]
      },
      {
        "id": 5,
        "title": "Calibration Error",
        "type": "timeseries",
        "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
        "targets": [
          {
            "expr": "model_calibration_error",
            "legendFormat": "ECE"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "short",
            "thresholds": {
              "steps": [
                { "color": "green", "value": 0 },
                { "color": "yellow", "value": 0.05 },
                { "color": "red", "value": 0.1 }
              ]
            }
          }
        }
      },
      {
        "id": 6,
        "title": "Data Drift Score",
        "type": "gauge",
        "gridPos": { "h": 8, "w": 6, "x": 12, "y": 16 },
        "targets": [
          {
            "expr": "drift_score",
            "legendFormat": "Drift Score"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "short",
            "min": 0,
            "max": 1,
            "thresholds": {
              "steps": [
                { "color": "green", "value": 0 },
                { "color": "yellow", "value": 0.2 },
                { "color": "red", "value": 0.3 }
              ]
            }
          }
        }
      },
      {
        "id": 7,
        "title": "Last Model Training",
        "type": "stat",
        "gridPos": { "h": 8, "w": 6, "x": 18, "y": 16 },
        "targets": [
          {
            "expr": "time() - model_last_trained_timestamp",
            "legendFormat": "Time Since Training"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "s",
            "thresholds": {
              "steps": [
                { "color": "green", "value": 0 },
                { "color": "yellow", "value": 259200 },
                { "color": "red", "value": 604800 }
              ]
            }
          }
        }
      }
    ]
  }
}
