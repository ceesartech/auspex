{
  "dashboard": {
    "id": null,
    "uid": "infrastructure",
    "title": "Infrastructure Overview",
    "tags": ["infrastructure", "kubernetes", "system"],
    "timezone": "browser",
    "schemaVersion": 36,
    "version": 1,
    "refresh": "30s",
    "time": { "from": "now-1h", "to": "now" },
    "panels": [
      {
        "id": 1,
        "title": "CPU Usage by Pod",
        "type": "timeseries",
        "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
        "targets": [
          {
            "expr": "pod:container_cpu_usage:rate5m{namespace=\"betting-system\"}",
            "legendFormat": "{{ pod }}"
          }
        ],
        "fieldConfig": { "defaults": { "unit": "percentunit" } }
      },
      {
        "id": 2,
        "title": "Memory Usage by Pod",
        "type": "timeseries",
        "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
        "targets": [
          {
            "expr": "pod:container_memory_usage_ratio{namespace=\"betting-system\"}",
            "legendFormat": "{{ pod }}"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "percentunit",
            "thresholds": {
              "steps": [
                { "color": "green", "value": 0 },
                { "color": "yellow", "value": 0.7 },
                { "color": "red", "value": 0.9 }
              ]
            }
          }
        }
      },
      {
        "id": 3,
        "title": "Pod Restart Count",
        "type": "timeseries",
        "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
        "targets": [
          {
            "expr": "sum(kube_pod_container_status_restarts_total{namespace=\"betting-system\"}) by (pod)",
            "legendFormat": "{{ pod }}"
          }
        ],
        "fieldConfig": { "defaults": { "unit": "short" } }
      },
      {
        "id": 4,
        "title": "HPA Replica Count",
        "type": "timeseries",
        "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
        "targets": [
          {
            "expr": "kube_horizontalpodautoscaler_status_current_replicas{namespace=\"betting-system\"}",
            "legendFormat": "{{ horizontalpodautoscaler }} current"
          },
          {
            "expr": "kube_horizontalpodautoscaler_spec_max_replicas{namespace=\"betting-system\"}",
            "legendFormat": "{{ horizontalpodautoscaler }} max"
          }
        ],
        "fieldConfig": { "defaults": { "unit": "short" } }
      },
      {
        "id": 5,
        "title": "Node Disk Usage",
        "type": "timeseries",
        "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
        "targets": [
          {
            "expr": "1 - (node_filesystem_avail_bytes{mountpoint=\"/\"} / node_filesystem_size_bytes{mountpoint=\"/\"})",
            "legendFormat": "{{ instance }}"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "percentunit",
            "thresholds": {
              "steps": [
                { "color": "green", "value": 0 },
                { "color": "yellow", "value": 0.7 },
                { "color": "red", "value": 0.9 }
              ]
            }
          }
        }
      },
      {
        "id": 6,
        "title": "PostgreSQL Connection Pool",
        "type": "gauge",
        "gridPos": { "h": 8, "w": 6, "x": 12, "y": 16 },
        "targets": [
          {
            "expr": "postgres:connection_pool_utilisation",
            "legendFormat": "DB Connections"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "percentunit",
            "min": 0,
            "max": 1,
            "thresholds": {
              "steps": [
                { "color": "green", "value": 0 },
                { "color": "yellow", "value": 0.6 },
                { "color": "red", "value": 0.8 }
              ]
            }
          }
        }
      },
      {
        "id": 7,
        "title": "Redis Memory Usage",
        "type": "gauge",
        "gridPos": { "h": 8, "w": 6, "x": 18, "y": 16 },
        "targets": [
          {
            "expr": "redis_memory_used_bytes / redis_memory_max_bytes",
            "legendFormat": "Redis Memory"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "percentunit",
            "min": 0,
            "max": 1,
            "thresholds": {
              "steps": [
                { "color": "green", "value": 0 },
                { "color": "yellow", "value": 0.6 },
                { "color": "red", "value": 0.8 }
              ]
            }
          }
        }
      }
    ]
  }
}
