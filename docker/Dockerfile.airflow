FROM apache/airflow:2.8.0-python3.11

USER root

# Install system dependencies + the Docker CLI and Compose v2 plugin.
# The DAGs orchestrate work via `docker compose exec api …` against the
# host docker daemon (the socket is bind-mounted at runtime). The build
# tools are kept in case a future DAG needs psycopg2 wheels to compile.
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    libpq-dev \
    ca-certificates \
    curl \
    gnupg \
    && install -m 0755 -d /etc/apt/keyrings \
    && curl -fsSL https://download.docker.com/linux/debian/gpg \
       | gpg --dearmor -o /etc/apt/keyrings/docker.gpg \
    && chmod a+r /etc/apt/keyrings/docker.gpg \
    && echo "deb [arch=$(dpkg --print-architecture) signed-by=/etc/apt/keyrings/docker.gpg] \
       https://download.docker.com/linux/debian \
       $(. /etc/os-release && echo "${VERSION_CODENAME}") stable" \
       > /etc/apt/sources.list.d/docker.list \
    && apt-get update \
    && apt-get install -y --no-install-recommends \
       docker-ce-cli \
       docker-compose-plugin \
    && rm -rf /var/lib/apt/lists/*

# Modal CLI in an ISOLATED venv. The retrain DAG's modal_trigger task calls
# /opt/modal-venv/bin/modal when the training_backend Variable is 'modal'. It
# lives in its own venv (NOT the Airflow env) so modal's deps can't collide with
# Airflow 2.8's pin set — the same reason the root requirements.txt is not
# installed here. Auth is via MODAL_TOKEN_ID/SECRET env (no config file needed).
#
# PIP_USER=false is required: the apache/airflow base image sets PIP_USER=true
# (so the airflow user's installs land in ~/.local), which makes pip attempt a
# '--user' install INSIDE the venv and fail ("User site-packages are not visible
# in this virtualenv"). Unset it for both venv creation + the install.
RUN PIP_USER=false python3 -m venv /opt/modal-venv \
    && PIP_USER=false /opt/modal-venv/bin/pip install --no-cache-dir modal

USER airflow

# DO NOT install the root requirements.txt here. It pins
# sqlalchemy==2.0.36, which Airflow 2.8 is incompatible with — that
# upgrade triggers
#   sqlalchemy.exc.ArgumentError: Invalid value for 'executemany_mode': 'values'
# at startup. Our DAGs run via BashOperator that exec's the api
# container (which already has the full Python stack), so the Airflow
# image only needs what apache/airflow:2.8.0-python3.11 ships with.
#
# If a future DAG needs to import Python deps directly inside the
# Airflow container, add a curated requirements-airflow-runtime.txt
# constrained to Airflow's own pin set:
#   pip install --constraint \
#     https://raw.githubusercontent.com/apache/airflow/constraints-2.8.0/constraints-3.11.txt \
#     -r /tmp/requirements-airflow-runtime.txt

# Copy DAGs only. The scraper code lives in the api image; DAGs invoke
# it via `docker compose exec api python ...` rather than importing it.
COPY services/data-ingestion/dags/ /opt/airflow/dags/

EXPOSE 8080
